<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    <meta name="description" content="Documented - online and offline business documents." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="/css/site.css" />
    <title>@ViewData["Title"] - Documented</title>
</head>
<body>
<header class="topbar">
    <a class="brand" href="/">DOCUMENTED<span>.</span></a>
    <nav>
        <a href="/">Documents</a>
        <a href="/Setup">Business setup</a>
    </nav>
</header>

<main class="shell">
    @RenderBody()
</main>

<footer class="footer">Documented · reusable business documents · online + offline</footer>

<script src="/js/app.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
