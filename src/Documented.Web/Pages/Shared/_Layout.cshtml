<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    <meta name="description" content="Documented - online and offline business documents." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="/css/site.css" />
    <title>@ViewData["Title"] - Documented</title>
</head>
<body>
<header class="topbar">
    <a class="brand" href="@((User.Identity?.IsAuthenticated ?? false) ? "/" : "/Account")">DOCUMENTED<span>.</span></a>
    <nav>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a href="/">Documents</a>
            <a href="/Setup">Business setup</a>
            <button type="button" class="nav-button" id="logoutButton">Logout</button>
        }
        else
        {
            <a href="/Account">Login / Register</a>
        }
    </nav>
</header>

<main class="shell">
    @RenderBody()
</main>

<footer class="footer">Documented · reusable business documents · online + offline</footer>

<script src="/js/app.js"></script>
<script src="/js/auth.js"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("logoutButton")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/Account";
    });
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
