@page "/d/{token}"
@model Documented.Web.Pages.PublicDocumentModel
@{
    ViewData["Title"] = Model.Document?.Number ?? "Document";
}

@if (Model.Document is null)
{
    <section class="panel narrow"><h1>Document not found</h1><p class="muted">The link may be invalid or the document may no longer be available.</p></section>
}
else
{
    <div class="print-actions">
        <a class="ghost" href="/">Documented</a>
        <div class="share-actions">
            <button class="ghost" id="copyLink" type="button">Copy link</button>
            <a class="ghost" id="whatsappShare" target="_blank" rel="noopener">WhatsApp</a>
            <button class="primary" onclick="window.print()" type="button">Print / Save PDF</button>
        </div>
    </div>

    <article class="invoice @Model.Document.Business.TemplateKey">
        <div class="invoice-top">
            <div class="invoice-brand">
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.LogoUrl))
                {
                    <img class="invoice-logo" src="@Model.Document.Business.LogoUrl" alt="@Model.Document.Business.BusinessName logo" />
                }
                <h1>@Model.Document.Business.BusinessName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.Slogan))
                {
                    <p class="invoice-slogan">@Model.Document.Business.Slogan</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.Address))
                {
                    <p>@Model.Document.Business.Address</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.Phone) || !string.IsNullOrWhiteSpace(Model.Document.Business.Email))
                {
                    <p>
                        @if (!string.IsNullOrWhiteSpace(Model.Document.Business.Phone))
                        {
                            @Model.Document.Business.Phone
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Document.Business.Phone) && !string.IsNullOrWhiteSpace(Model.Document.Business.Email))
                        {
                            <span> · </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Document.Business.Email))
                        {
                            @Model.Document.Business.Email
                        }
                    </p>
                }
            </div>

            <div class="invoice-meta">
                <strong>@Model.Document.DocumentType.ToUpperInvariant()</strong>
                <div><span>NO:</span> @Model.Document.Number</div>
                <div><span>DATE:</span> @Model.Document.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <div class="bill-to">
            <strong>BILL TO</strong>
            <div>@Model.Document.CustomerName</div>
            @if (!string.IsNullOrWhiteSpace(Model.Document.CustomerPhone))
            {
                <div>@Model.Document.CustomerPhone</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Document.CustomerEmail))
            {
                <div>@Model.Document.CustomerEmail</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Document.CustomerAddress))
            {
                <div>@Model.Document.CustomerAddress</div>
            }
        </div>

        <table>
            <thead><tr><th>QTY</th><th>PARTICULARS</th><th>UNIT PRICE</th><th>AMOUNT</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Document.Items)
            {
                <tr>
                    <td>@item.Quantity.ToString("N2")</td>
                    <td>@item.Description</td>
                    <td>@item.UnitPrice.ToString("N2")</td>
                    <td>@item.LineTotal.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="invoice-bottom">
            <div class="payment-box">
                <h3>PAYMENT DETAILS</h3>

                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.BankName))
                {
                    <div class="payment-line"><span>Bank</span><strong>@Model.Document.Business.BankName</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.BankAccountName))
                {
                    <div class="payment-line"><span>Account name</span><strong>@Model.Document.Business.BankAccountName</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.BankAccountNumber))
                {
                    <div class="payment-line"><span>Account no.</span><strong>@Model.Document.Business.BankAccountNumber</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.MobileMoneyName))
                {
                    <div class="payment-line"><span>Mobile money</span><strong>@Model.Document.Business.MobileMoneyName</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Document.Business.MobileMoneyNumber))
                {
                    <div class="payment-line"><span>Number</span><strong>@Model.Document.Business.MobileMoneyNumber</strong></div>
                }

                @if (string.IsNullOrWhiteSpace(Model.Document.Business.BankName)
                    && string.IsNullOrWhiteSpace(Model.Document.Business.BankAccountName)
                    && string.IsNullOrWhiteSpace(Model.Document.Business.BankAccountNumber)
                    && string.IsNullOrWhiteSpace(Model.Document.Business.MobileMoneyName)
                    && string.IsNullOrWhiteSpace(Model.Document.Business.MobileMoneyNumber))
                {
                    <p class="payment-empty">Payment details have not been configured yet. Add them in Business Setup.</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Document.Notes))
                {
                    <div class="notes-block">
                        <h3>OTHER COMMENTS</h3>
                        <p>@Model.Document.Notes</p>
                    </div>
                }
            </div>

            <div class="summary">
                <div><span>Subtotal</span><strong>@Model.Document.Subtotal.ToString("N2")</strong></div>
                @if (Model.Document.Discount > 0)
                {
                    <div><span>Discount</span><strong>@Model.Document.Discount.ToString("N2")</strong></div>
                }
                <div class="grand"><span>GRAND TOTAL</span><strong>@Model.Document.Total.ToString("N2")</strong></div>
            </div>
        </div>

        <div class="invoice-footer">@Model.Document.Business.FooterText</div>
    </article>

    <script>
        (() => {
            const url = window.location.href;
            const message = encodeURIComponent("@Model.Document.Business.BusinessName - @Model.Document.DocumentType @Model.Document.Number
" + url);
            document.getElementById("whatsappShare").href = "https://wa.me/?text=" + message;
            document.getElementById("copyLink").addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(url);
                    document.getElementById("copyLink").textContent = "Copied";
                    setTimeout(() => document.getElementById("copyLink").textContent = "Copy link", 1600);
                } catch {
                    window.prompt("Copy this document link:", url);
                }
            });
        })();
    </script>
}
